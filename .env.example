# ==============================================================================
# CODEPHANTOM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local to configure your local development environment.
# Never commit real API keys or secrets to version control.

# Google Gemini API Key for dynamic, on-demand AI challenge generation
# (Optional: If omitted or left empty, CodePhantom seamlessly operates in
# Verified Offline / Fallback mode with built-in story-driven challenges)
VITE_GEMINI_API_KEY=

# Gemini Model identifier (default: gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional Backend Sandbox URL (for isolated Docker/gVisor remote runner)
# When empty, client-side safe JavaScript & Python execution engines are used.
VITE_SANDBOX_API_URL=

# Optional Firebase Configuration (for cloud sync across devices)
# If left empty, CodePhantom uses high-performance local persistent storage (localStorage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
